# Copy to .env and fill in. This file stays on your computer (.env is git-ignored).
# SQLite file by default. On Vercel this is a Postgres URL (postgres://... is fine).
GA_DATABASE_URL=sqlite:///./data/garmin.db
# Comma-separated origins allowed to call the API (the Vite dev server by default).
GA_CORS_ORIGINS=http://localhost:5173

# Garmin Connect login, used for the first sync. After that the app reuses the saved
# login tokens in GA_GARMIN_TOKEN_DIR, so you can delete the password line if you like.
GA_GARMIN_EMAIL=
GA_GARMIN_PASSWORD=
GA_GARMIN_TOKEN_DIR=./data/garmin_tokens
# Only for hosts with no writable disk (Vercel): paste the whole contents of
# garmin_tokens.json here instead of using GA_GARMIN_TOKEN_DIR.
# GA_GARMIN_TOKENS=
