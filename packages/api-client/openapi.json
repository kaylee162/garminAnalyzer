{
  "openapi": "3.1.0",
  "info": {
    "title": "Garmin Analyzer API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/activities": {
      "get": {
        "tags": [
          "activities"
        ],
        "summary": "List Activities",
        "description": "Activities newest first, optionally only one sport.",
        "operationId": "listActivities",
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "run",
                    "bike",
                    "other"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sport"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/activities/compare": {
      "get": {
        "tags": [
          "activities"
        ],
        "summary": "Compare",
        "description": "Compare two activities. Pass them in either order; the earlier one is the baseline.",
        "operationId": "compareActivities",
        "parameters": [
          {
            "name": "a",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Id of one activity",
              "title": "A"
            },
            "description": "Id of one activity"
          },
          {
            "name": "b",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Id of the other activity",
              "title": "B"
            },
            "description": "Id of the other activity"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityComparison"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/activities/{activity_id}": {
      "get": {
        "tags": [
          "activities"
        ],
        "summary": "Get Activity",
        "operationId": "getActivity",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Activity Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivitySummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/activities/{activity_id}/details": {
      "get": {
        "tags": [
          "activities"
        ],
        "summary": "Get Activity Details",
        "operationId": "getActivityDetails",
        "parameters": [
          {
            "name": "activity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Activity Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sync/status": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Sync Status",
        "operationId": "getSyncStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatus"
                }
              }
            }
          }
        }
      }
    },
    "/sync": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Run Sync",
        "description": "Fetch new activities from Garmin now.",
        "operationId": "runSync",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResultOut"
                }
              }
            }
          },
          "502": {
            "description": "Garmin login or fetch failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GarminProblem"
                }
              }
            }
          }
        }
      }
    },
    "/plan": {
      "get": {
        "tags": [
          "plan"
        ],
        "summary": "Plan",
        "description": "Estimate race time from recent runs and lay out the weeks until race day.\n\nNothing is stored: the plan is recalculated from your latest runs on every request.",
        "operationId": "buildTrainingPlan",
        "parameters": [
          {
            "name": "race",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "5k",
                "10k",
                "20k",
                "half_marathon",
                "marathon"
              ],
              "type": "string",
              "description": "What you're training for",
              "title": "Race"
            },
            "description": "What you're training for"
          },
          {
            "name": "race_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Race day, YYYY-MM-DD",
              "title": "Race Date"
            },
            "description": "Race day, YYYY-MM-DD"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingPlan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityComparison": {
        "properties": {
          "earlier": {
            "$ref": "#/components/schemas/ActivitySummary"
          },
          "later": {
            "$ref": "#/components/schemas/ActivitySummary"
          },
          "days_between": {
            "type": "number",
            "title": "Days Between"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricComparison"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "earlier",
          "later",
          "days_between",
          "metrics"
        ],
        "title": "ActivityComparison",
        "description": "Two runs side by side. The runs are put in date order and changes run earlier -> later."
      },
      "ActivityDetails": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "sections": {
            "items": {
